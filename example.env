# Server Configuration
VOCDONI_SERVERURL=http://localhost:8080
VOCDONI_HOST=0.0.0.0
VOCDONI_PORT=8080
VOCDONI_SECRET=supersecret
VOCDONI_WEBURL=https://saas-dev.vocdoni.app
VOCDONI_LOGLEVEL=info
# Deployment environment: development, staging or production (default). The first two are named to users
# (SMS start with "[DEV] " or "[STG] ").
VOCDONI_ENVIRONMENT=development

# Vocdoni API Configuration
VOCDONI_VOCDONIAPI=https://api-dev.vocdoni.net/v2
VOCDONI_PRIVATEKEY=your-vochain-private-key-here
VOCDONI_FULLTRANSPARENTMODE=false

# MongoDB Configuration
VOCDONI_MONGOURL=mongodb://localhost:27017
VOCDONI_MONGODB=vocdoni-saas

# SMTP Email Configuration
VOCDONI_SMTPSERVER=smtp.server.com
VOCDONI_SMTPPORT=587
VOCDONI_SMTPUSERNAME=admin
VOCDONI_SMTPPASSWORD=password
VOCDONI_EMAILFROMADDRESS=admin@email.com
VOCDONI_EMAILFROMNAME=Vocdoni

# Optional backup SMTP relay for email failover.
# Leave VOCDONI_BACKUPSMTPSERVER empty to disable. When set (together with the
# backup username and password), email is sent through the primary relay and
# falls over to this backup if the primary submission fails. The backup shares
# the same sender identity (VOCDONI_EMAILFROMADDRESS / VOCDONI_EMAILFROMNAME);
# only the relay below differs, so it must be authorized to send for the same
# domain (SPF/DKIM/DMARC).
# VOCDONI_BACKUPSMTPSERVER=smtp.backup-provider.com
# VOCDONI_BACKUPSMTPPORT=587
# VOCDONI_BACKUPSMTPUSERNAME=admin
# VOCDONI_BACKUPSMTPPASSWORD=password

# Twilio SMS Configuration
VOCDONI_TWILIOACCOUNTSID=your-twilio-account-sid
VOCDONI_TWILIOAUTHTOKEN=your-twilio-auth-token
VOCDONI_TWILIOFROMNUMBER=+1234567890
# Optional: numeric sender used when Twilio refuses VOCDONI_TWILIOFROMNUMBER for a recipient (error 21612)
# VOCDONI_TWILIOFALLBACKFROMNUMBER=+1234567890
# Optional: Twilio Verify service (custom codes enabled) that delivers one-time codes in any country;
# a code it fails to deliver goes out as a direct SMS from the senders above
# VOCDONI_TWILIOVERIFYSERVICESID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, with Verify: prefixes whose codes go out as direct SMS (cheaper, no Verify fee),
# falling back to Verify only when every sender is refused (21612)
# VOCDONI_TWILIODIRECTPREFIXES=+34,+39,+55

# Optional: send a delivery-check SMS ("Your Vocdoni Canary verification code is: ...") to this number every interval
# (default 24h, at least 1h). Use a real mobile on the route to watch and set it on one instance only.
# VOCDONI_SMSCANARYNUMBER=+34600000000
# VOCDONI_SMSCANARYINTERVAL=24h

# Optional: serve Prometheus metrics on /metrics to requests with "Authorization: Bearer <token>"
# VOCDONI_METRICSTOKEN=

# Optional: send a delivery-check SMS ("Your Vocdoni Canary verification code is: ...") to this number every interval
# (default 24h, at least 1h). Use a real mobile on the route to watch and set it on one instance only.
# VOCDONI_SMSCANARYNUMBER=+34600000000
# VOCDONI_SMSCANARYINTERVAL=24h

# Optional: serve Prometheus metrics on /metrics to requests with "Authorization: Bearer <token>"
# VOCDONI_METRICSTOKEN=

# Stripe Configuration
VOCDONI_STRIPEAPISECRET=sk_test_your_stripe_secret_key
VOCDONI_STRIPEWEBHOOKSECRET=whsec_your_stripe_webhook_secret

# OAuth Configuration
VOCDONI_OAUTHSERVICEURL=http://oauth.vocdoni.net

# Origin secret: when set, every request except /ping must carry it in the X-Origin-Secret
# header. Have the edge proxy (Cloudflare) add the header, so the origin can't be reached around it.
# VOCDONI_ORIGINSECRET=

# Question status sync worker (reconciles /processes question statuses with the Vochain on demand:
# on a status change made through the API, or on a read of the process/question).
# Durations of 0 use the built-in defaults (60s interval, 5m confirm timeout).
VOCDONI_STATUSSYNCINTERVAL=60s
VOCDONI_STATUSSYNCCONFIRMTIMEOUT=5m

# CSP voter abuse caps (0 = built-in default, negative = disabled).
# Challenge emails/SMS (new tokens + resends) per member and process per UTC day (default 10).
# VOCDONI_CSPMAXDAILYSENDS=10
# Failed step-0 logins per submitted set of login fields and process per UTC hour (default 10).
# Whoever knows a voter's login fields can spend it, locking that voter out until the next hour.
# VOCDONI_CSPMAXHOURLYAUTHFAILURES=10

# Temporarily stop offering anonymous voting: when true, processes with an anonymous census cannot be
# created, updated or published (unless already partially on chain), and blind signing is refused (default false).
# VOCDONI_DISABLE_BLINDCSP=false

# Certificate voter authentication: the certificate gateway public keys, as comma-separated
# keyId:base64(Ed25519 public key) entries (several at once to rotate a key without downtime).
# Empty or unset turns the feature off: POST /cert-auth/assertions answers 404 and censuses with
# certAuth are refused.
# VOCDONI_CERT_GATEWAY_PUBLIC_KEYS=dev-1:BASE64PUBLICKEY=
